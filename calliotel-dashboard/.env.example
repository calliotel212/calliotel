# --- PostgreSQL (docker-compose service: postgres) ---
POSTGRES_USER=calliotel
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=calliotel_dashboard
DATABASE_URL=postgresql+psycopg://calliotel:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/calliotel_dashboard

# --- Redis (AdsFind click fraud shield — docker-compose service: redis) ---
REDIS_URL=redis://redis:6379/0

# --- Optional: advertiser website audit LLM (mock report if unset) ---
# OPENAI_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_URL=http://localhost:3000

# --- Resend (forgot password) ---
RESEND_API_KEY=REPLACE_WITH_YOUR_RESEND_KEY
EMAIL_FROM=Calliotel <noreply@calliotel.ai>

# --- AdsFind internal API (voice-ai-platform) ---
# Prefer per-publisher keys (register at /publishers or seed_platform_publisher.py)
# PUBLISHER_API_KEY is set on voice-ai-platform, not the dashboard.
INTERNAL_ADS_API_KEY=REPLACE_WITH_SHARED_SECRET

# --- Platform admin console (/admin) — set in production ---
ADMIN_SECRET=REPLACE_WITH_LONG_RANDOM_ADMIN_SECRET
# ADMIN_API_KEY=optional header X-Admin-Api-Key for automation
# ADMIN_EMAILS=owner@calliotel.ai,ops@calliotel.ai
# ADMIN_JWT_EXPIRE_MINUTES=30

# --- Next.js (browser) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Production (droplet + Caddy — fill when deploying) ---
# API_PUBLIC_URL=https://app.calliotel.ai
# FRONTEND_URL=https://app.calliotel.ai
# NEXT_PUBLIC_API_URL=https://app.calliotel.ai
