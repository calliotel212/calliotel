# Required in production. Local `next dev` falls back to a built-in dev secret when this is empty.
AUTH_SECRET=

# Public origin, used for password-reset and email-verification links.
AUTH_URL=http://localhost:3000

# Trust the host header when the app sits behind a proxy.
AUTH_TRUST_HOST=true

# Google sign-in (Auth.js). Both values are required.
# Leave blank and the button shows "Not configured".
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Facebook sign-in (Auth.js). Both values are required.
# Leave blank and the button shows "Not configured".
# https://developers.facebook.com/apps/
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Apple sign-in (Auth.js). Both values are required.
# AUTH_APPLE_SECRET is the Sign in with Apple client secret (a JWT from your Apple key).
# Leave blank and the button shows "Not configured".
# https://developer.apple.com/account/resources/identifiers/list/serviceId
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# Postgres connection string. Production uses Postgres.
# Leave blank and local development uses SQLite at data/dramame.db.
DATABASE_URL=

# Instagram is not a login provider. Follow links stay hidden until lib/social.ts has real profile URLs.

# Signed-in email allowed to open /admin. Leave blank to keep that page unavailable.
ADMIN_EMAIL=

# Resend. Both values are required to send verification and password-reset mail.
# Leave either blank and sending is skipped. Local development still shows the link.
# EMAIL_FROM must be a verified sender on dramame.net, for example noreply@dramame.net.
RESEND_API_KEY=
EMAIL_FROM=

# Direct Kling HTTP API. The generate pipeline does not read these. Leave blank.
KLING_API_KEY=
KLING_API_BASE=

# ElevenLabs text-to-speech and voice changer. Leave blank.
# An empty value does not affect the build. That generate run logs why and marks the video failed.
ELEVENLABS_API_KEY=

# fal.ai key for Kling 2.6 clips. Leave blank.
# An empty value does not affect the build. That generate run logs why and marks the video failed.
FAL_API_KEY=

# Optional http(s) still for Kling image-to-video. Leave blank to use text-to-video.
DRAMAME_START_IMAGE_URL=
