# Full cloud stack template — copy to .env on production droplet
# LiveKit (Cloud or self-hosted with TLS)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional named worker registration
# LIVEKIT_AGENT_NAME=calliotel-voice-assistant

# LLM — Groq (OpenAI-compatible)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Optional local Ollama (not used when LLM_PROVIDER=groq)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=huihui_ai/qwen3-abliterated:8b

# Speech — Deepgram STT + TTS (no on-box Whisper/Piper load)
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-andromeda-en
USE_SILERO_VAD=false

TTS_PROVIDER=deepgram

# Optional Cartesia voice (set TTS_PROVIDER=cartesia)
# TTS_PROVIDER=cartesia
# CARTESIA_API_KEY=
# CARTESIA_VOICE=

# Redis (optional orchestration; agent runs without hard dependency on features using it)
REDIS_URL=redis://127.0.0.1:6379/0

# Whisper fallback only if DEEPGRAM_API_KEY is unset
# WHISPER_MODEL=base.en
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# WHISPER_VAD_FILTER=false
