# LiveKit Cloud or self-hosted (wss:// for TLS)
LIVEKIT_URL=wss://...
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: register a named agent (overrides livekit.toml when set)
# LIVEKIT_AGENT_NAME=calliotel-voice-assistant

# LLM: Groq cloud (recommended on small droplets)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Optional local LLM (docker compose --profile local-llm up ollama)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://ollama:11434/v1
# OLLAMA_MODEL=huihui_ai/qwen3-abliterated:4b

# STT / TTS cloud (Deepgram)
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-andromeda-en
USE_SILERO_VAD=false

TTS_PROVIDER=deepgram

# Optional Cartesia TTS instead of Deepgram
# TTS_PROVIDER=cartesia
# CARTESIA_API_KEY=
# CARTESIA_VOICE=

# Self-hosted TTS fallback (CPU-heavy on droplet)
# TTS_PROVIDER=piper
# PIPER_VOICE=en_US-lessac-medium
# PIPER_DATA_DIR=/data/piper

# Session / orchestration (reserved for platform services; not required by LiveKit worker today)
REDIS_URL=redis://redis:6379/0

# Local Whisper when DEEPGRAM_API_KEY is empty
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_VAD_FILTER=false
