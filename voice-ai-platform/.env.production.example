# LiveKit Cloud or self-hosted (wss:// for TLS)
LIVEKIT_URL=wss://...
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: register a named agent (overrides livekit.toml when set)
# LIVEKIT_AGENT_NAME=calliotel-voice-assistant

# In-stack Ollama (OpenAI-compatible /v1 base)
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=huihui_ai/qwen3-abliterated:4b

# STT: set for cloud Deepgram; leave empty for local faster-whisper
DEEPGRAM_API_KEY=

# Self-hosted TTS (recommended on Python 3.12)
TTS_PROVIDER=piper
PIPER_VOICE=en_US-lessac-medium
PIPER_DATA_DIR=/data/piper

# Session / orchestration (reserved for platform services; not required by LiveKit worker today)
REDIS_URL=redis://redis:6379/0

# Local Whisper when DEEPGRAM_API_KEY is empty
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_VAD_FILTER=false
