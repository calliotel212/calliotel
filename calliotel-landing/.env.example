# App dashboard (advertise, publishers, login links on the marketing site)
# Production: https://app.calliotel.ai — Local dashboard dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=https://app.calliotel.ai

# LiveKit voice demo (/demo page)
LIVEKIT_URL=wss://calliotel-ai-6kc97c5t.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Must match the agent worker name (voice-ai-platform livekit.toml)
LIVEKIT_AGENT_NAME=calliotel-voice-assistant

# Max browser demo duration in seconds (client timer + token TTL hint)
DEMO_MAX_SECONDS=300